# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example 只放占位符，必须提交，否则别人不知道要配什么
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 本地详细计划：记录每一步的卡点和踩过的坑，给评委看的简版是 plan.md
plan.local.md
